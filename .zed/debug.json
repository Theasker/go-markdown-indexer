// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    // Debug the file currently focused in the editor (F4, then pick this label).
    //
    // `program: "$ZED_FILE"` makes Delve build ONLY that single file, which is
    // required here: every file under pruebas/ declares `package main` on its
    // own, so building the package as a whole fails with "main redeclared".
    //
    // `cwd` must stay inside the module, otherwise Go cannot resolve go.mod
    // ("no required module provides package github.com/goforj/godump").
    "adapter": "Delve",
    "label": "Debug arbolDir03.go",
    "request": "launch",
    "mode": "debug",
    "program": "$ZED_FILE",
    "cwd": "${ZED_WORKTREE_ROOT}"
  }
]
